# MongoDB Atlas connection string for the local VaaniDoc database.
# Do not commit a real username, password, or connection string.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vaani_doc_local?retryWrites=true&w=majority
PORT=5000
# Change this before using the API outside local development.
VAANIDOC_TOKEN_SECRET=replace-with-a-long-random-secret
# Python executable containing the root requirements.txt dependencies.
# Windows example: C:\\path\\to\\venv\\Scripts\\python.exe
PYTHON_EXECUTABLE=python
# Maximum time allowed for PDF/OCR extraction.
EXTRACTION_TIMEOUT_MS=180000

# Optional multilingual transcription/normalization provider. Without this
# key, the service uses the conservative explicit-phrase fallback and keeps
# unrecognized input in REVIEW_REQUIRED state.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

MONGO_URI=mongodb+srv://Admin123:Admin123@cluster0.kgvuu9j.mongodb.net/vaani_doc_local?retryWrites=true&w=majority&appName=Cluster0
Port = 5000
VAANIDOC_TOKEN_SECRET=use-a-long-random-local-secret

