# MongoDB Atlas connection string for the local VaaniDoc database.
# Do not commit a real username, password, or connection string.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vaani_doc_local?retryWrites=true&w=majority
PORT=5000
# Change this before using the API outside local development.
VAANIDOC_TOKEN_SECRET=replace-with-a-long-random-secret
